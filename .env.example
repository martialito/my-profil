# ─── Copy this file to .env and fill in the values. Never commit .env. ───

# Server (binds to localhost only by default: this app holds personal data)
HOST=127.0.0.1
PORT=3001
NODE_ENV=development

# SQLite database file (path relative to project root)
DATABASE_URL=./data/app.db

# 32-byte key used to encrypt personal information at rest (AES-256-GCM).
# Generate one with:  npm run gen:key
# WARNING: if you lose this key, encrypted profile fields cannot be recovered.
ENCRYPTION_KEY=

# LLM provider ("anthropic" for now; the architecture allows adding others)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional override of the model configured in Settings
# ANTHROPIC_MODEL=claude-opus-5-5

# Storage locations (relative to project root)
DATA_DIR=./data
GENERATED_DIR=./generated
LOG_DIR=./logs

# Safety: while TEST_MODE=true, the app NEVER submits a real application.
TEST_MODE=true

# Browser automation (Phase 6). Install the browser once with: npx playwright install chromium
# Or point to an existing Chromium/Chrome binary:
# BROWSER_EXECUTABLE_PATH=

# Optional notification channels (not implemented yet — Phase 5+)
# NOTIFY_EMAIL=
