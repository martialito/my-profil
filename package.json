{
  "name": "nyc-internship-agent",
  "version": "0.1.0",
  "private": true,
  "description": "NYC internship search & application assistant (human-in-the-loop).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.6",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "mammoth": "^1.13.0",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "docx": "^9.9.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "pdfkit": "^0.20.2",
    "supertest": "^7.3.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"tsx watch --clear-screen=false src/server.ts\" \"vite\"",
    "build": "tsc -p . && vite build && tsup",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && tsc -p .",
    "typecheck": "tsc -p .",
    "gen:key": "tsx src/cli.ts gen-key",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/cli.ts migrate",
    "status": "tsx src/cli.ts status",
    "search": "tsx src/cli.ts search",
    "analyze": "tsx src/cli.ts analyze",
    "generate": "tsx src/cli.ts generate",
    "apply": "tsx src/cli.ts apply",
    "dry-run": "tsx src/cli.ts dry-run"
  }
}
